{
  "expo": {
    "name": "Word Maize",
    "slug": "word-maize",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wordmaize",
    "description": "Harvest words from a rotating corn cob.",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/word-maize/ui/logo-corn.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wordmaize.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wordmaize.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a3a18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      },
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": "",
      "privacyPolicyUrl": "https://wordmaize.com/privacy",
      "termsOfUseUrl": "https://wordmaize.com/terms",
      "admobRewardedUnitIdIos": "ca-app-pub-3940256099942544/1712485313",
      "admobRewardedUnitIdAndroid": "ca-app-pub-3940256099942544/5224354917"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
